# Local temporary files (reviews, scratch, etc.)
temporary/

# Dependencies
# No trailing slash so a git-worktree node_modules SYMLINK (a file, not a dir)
# is ignored too — a `node_modules/` pattern matches only directories and let a
# worktree symlink slip into a commit.
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment (never commit secrets)
.env
.env.*
# ...but DO commit `.env.example` — the curated, secret-free template
# DevOps uses to discover tunables (see file header for what belongs).
!.env.example

# Cursor (local editor state / plans)
.cursor/plans/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage
.grunt

# Bower dependency directory
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons
build/Release

# Dependency directories
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity




# parcel-bundler cache
.cache
.parcel-cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
# Anchored to repo root so it doesn't swallow source dirs named "public"
# (e.g. src/api/chat/public — the B2C public chat endpoint).
/public

# Storybook build outputs
.out
.storybook-out

