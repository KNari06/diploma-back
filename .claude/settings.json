{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/gcp)",
      "Read(**/gcp-*)"
    ],
    "allow": [
      "Bash(mkdir:*)",
      "Bash(tee:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(node:*)",
      "Bash(npx tsx:*)",
      "Bash(npm run type-check:*)",
      "Bash(npm run lint:*)",
      "Bash(npm test:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run worker:*)",
      "Bash(npm run scheduler:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git reset:*)",
      "Bash(git stash:*)",
      "Bash(git mv:*)",
      "Bash(git ls-remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git check-ignore:*)",
      "mcp__jira__jira_get_issue",
      "mcp__jira__jira_get_comments",
      "mcp__jira__jira_search_issues",
      "mcp__jira__jira_get_current_user",
      "mcp__jira__jira_get_project",
      "mcp__jira__jira_get_projects",
      "mcp__jira__jira_get_issue_types",
      "mcp__jira__jira_add_comment",
      "mcp__jira__jira_update_issue",
      "mcp__gitlab__get_merge_request",
      "mcp__gitlab__get_merge_request_diffs",
      "mcp__gitlab__get_merge_request_notes",
      "mcp__gitlab__list_merge_requests",
      "mcp__gitlab__list_merge_request_diffs",
      "mcp__gitlab__list_merge_request_changed_files",
      "mcp__gitlab__get_file_contents",
      "mcp__gitlab__get_project",
      "mcp__gitlab__list_projects",
      "mcp__gitlab__get_branch_diffs",
      "mcp__gitlab__get_commit",
      "mcp__gitlab__get_commit_diff",
      "mcp__gitlab__list_commits",
      "mcp__gitlab__create_merge_request",
      "mcp__gitlab__update_merge_request",
      "mcp__gitlab__create_or_update_file"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/pre-edit-doc-hint.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/check-claudemd-updated.js"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/validate-doc-maps.js"
          }
        ]
      }
    ]
  }
}
