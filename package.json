{
  "name": "qait-backend",
  "version": "1.0.0",
  "description": "QAIT - Quality Assurance Intelligence Testing Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "lsof -ti:3000 | xargs kill -9 2>/dev/null; nodemon --exec ts-node -r tsconfig-paths/register src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && npm run copy-config",
    "copy-config": "cp tsconfig.json dist/ 2>/dev/null || true",
    "start": "node dist/index.js",
    "worker": "nodemon --exec ts-node -r tsconfig-paths/register src/worker/index.ts",
    "start:worker": "node dist/worker/index.js",
    "scheduler": "nodemon --exec ts-node -r tsconfig-paths/register src/scheduler/index.ts",
    "start:scheduler": "node dist/scheduler/index.js",
    "build-kb": "ts-node -r tsconfig-paths/register src/scripts/build-global-kb.ts",
    "lite:analyze": "ts-node -r tsconfig-paths/register src/scripts/lite-analyze/cli.ts",
    "create-test-users": "ts-node -r tsconfig-paths/register scripts/create-test-users.ts",
    "create-admin-user": "ts-node -r tsconfig-paths/register scripts/create-admin-user.ts",
    "create-git-integration": "ts-node -r tsconfig-paths/register scripts/create-git-integration.ts",
    "analyze-selector": "ts-node -r tsconfig-paths/register scripts/analyze-playwright-selector.ts",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "setup": "cp env.example .env && echo '✅ Created .env file. Please edit it with your credentials.'"
  },
  "keywords": [
    "qa",
    "testing",
    "playwright",
    "ai",
    "automation",
    "saas"
  ],
  "author": "Ospanov Yerassyl",
  "license": "MIT",
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.38.4",
    "@types/multer": "^2.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/socket.io": "^3.0.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "adm-zip": "^0.5.16",
    "axios": "^1.6.2",
    "bullmq": "^4.18.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "imapflow": "^1.2.15",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "jsonpath-plus": "^10.4.0",
    "mammoth": "^1.11.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1",
    "openai": "^4.104.0",
    "openapi-types": "^12.1.3",
    "p-limit": "^7.2.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.56.1",
    "resend": "^6.9.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "stripe": "^14.21.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tiktoken": "^1.0.22",
    "tsconfig-paths": "^4.2.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/js-yaml": "^4.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.9.0",
    "@types/nodemailer": "^7.0.9",
    "@types/sharp": "^0.32.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
