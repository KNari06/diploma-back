INVESTOR_HASH=b5ada00f52eb540213ed10d0b4dcaae2f1311837fa164ab1f19810aa74be6be0
ADMIN_HASH=aa9e377e230bab36f88e2ce2e3c5ddf76c65d7b4fef142bb61065a8cb4604c02

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_jwt_secret_from_supabase_settings
SUPABASE_BUCKET_NAME=qai-assets

# Redis Configuration
REDIS_URL=redis://35.202.242.230:6379
REDIS_HOST=35.202.242.230
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1
OPENAI_MAX_TOKENS=4000

# Queue Configuration
QUEUE_CONCURRENCY=5
QUEUE_RETRY_ATTEMPTS=3
QUEUE_RETRY_DELAY=5000

# Agent Configuration
AGENT_TIMEOUT=300000
AGENT_MAX_RETRIES=1
AGENT_BASE_URL=https://api.qait.dev

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
JWT_SECRET=your_jwt_secret
API_KEY_SECRET=your_api_key_secret
ENCRYPTION_SECRET=your_encryption_secret_min_32_chars_for_aes256

# Frontend
FRONTEND_URL=http://localhost:3000
# Allowed origins for CORS (comma-separated for production)
ALLOWED_ORIGINS=http://localhost:8080,https://qait.dev,https://www.qait.dev

# Billing (Future)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Integrations
# Jira OAuth 2.0 (set in .env or .env.local, never commit secrets)
JIRA_CLIENT_ID=your_jira_client_id
JIRA_CLIENT_SECRET=your_jira_client_secret
# Callback must match Atlassian app config. Local: http://localhost:3000/api/v1/jira/callback
JIRA_CALLBACK_URL=http://localhost:3000/api/v1/jira/callback
# Legacy Jira (deprecated, use OAuth instead)
JIRA_BASE_URL=your_jira_url
JIRA_USERNAME=your_jira_username
JIRA_API_TOKEN=your_jira_token
SLACK_WEBHOOK_URL=your_slack_webhook_url

# Deployment Configuration (NOT committed to repository)
# These values should be set in local .env file only
DEPLOY_SSH_HOST=your_production_server_ip
DEPLOY_SSH_USER=your_ssh_username
DEPLOY_SSH_KEY_PATH=/path/to/your/ssh/private/key

# ─── Feature Flags ────────────────────────────────────────────────────
# Stage 2: LiteEngine de-weighting. Replaces hand-tuned numeric weights
# + per-iteration gemini-flash-lite enrichWithAI call with deterministic
# boolean signals from StateDiff (urlChanged, errors, widget-open,
# API success, Radix/shadcn data-state flips). Saves 1 LLM call per
# iteration. Multi-agent prompts (Observer/Strategist/Actor/Critic) and
# goal-completion-evaluator are dataState-aware regardless of this flag.
# Origin allowlist for `goto` and credential origin pinning are ALWAYS
# active (not gated by this flag).
#   0 = legacy weighted path (prod default — safe)
#   1 = deweighted path (enable on staging first, flip prod after telemetry parity)
LITE_ENGINE_DEWEIGHTED=0

# Etap 2: CDP-based snapshot collection (vs page.evaluate fallback).
# Independently flagged per consumer so rollout can be staged.
#   0 = use page.evaluate snapshot (prod default)
#   1 = use Chrome DevTools Protocol snapshot (faster on dense pages)
SNAPSHOT_USE_CDP_BACKGROUND=0
SNAPSHOT_USE_CDP_BACKGROUND_SHADOW=0
SNAPSHOT_USE_CDP_PREVIEW=0
SNAPSHOT_USE_CDP_PREVIEW_TICK_SHADOW=0
SNAPSHOT_USE_CDP_AI=0
# Sampling rate for shadow-mode CDP-vs-evaluate comparison (0..1)
SNAPSHOT_SHADOW_SAMPLING_RATE=1
