    style WriteAIPrompt fill:#87CEEB
    style WriteAIResponse fill:#87CEEB
    style WriteActionStart fill:#87CEEB
    style WriteActionEnd fill:#87CEEB
    style WriteIterEnd fill:#87CEEB
    style WriteRunEndSuccess fill:#FFD700
    style WriteRunEndCancelled fill:#FFB6C1
    style WriteRunEndBlocked fill:#FFB6C1
    style CloseFile fill:#FFA500
