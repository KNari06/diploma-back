# Supply-chain hardening — dependency lifecycle scripts are opt-in.
#
# preinstall/install/postinstall hooks run at install time, before any code is
# imported and before the app is ever started. That is the execution vector npm
# worms use, so it is off by default.
#
# Nothing here needs it: the production image already installs with
# --ignore-scripts, so sharp and msgpackr-extract are proven to resolve their
# prebuilt binaries via optional platform packages alone. This file covers
# local installs; both Dockerfile stages pass --ignore-scripts explicitly,
# because .npmrc is not COPYed into the image.
#
# If a native dep ever does need its hook, rebuild it explicitly and by name:
#   npm rebuild sharp msgpackr-extract
#
# Why: ../.claude/decisions/20260805-dependency-install-scripts-are-opt-in.md
ignore-scripts=true
